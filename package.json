{
  "name": "what-to-eat-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:vi": "ng serve --configuration=vi",
    "build": "ng build",
    "build:ssr": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
